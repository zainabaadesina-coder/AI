import random
from colorama import init, Fore, Style

# Initialize colorama to automatically reset text styling
init(autoreset=True)

def colored(cell):
    if cell == 'X':
        return Fore.RED + cell + Style.RESET_ALL
    elif cell == 'O':
        return Fore.BLUE + cell + Style.RESET_ALL
    else:
        return Fore.YELLOW + cell + Style.RESET_ALL

def display_board(board):
    print()
    # Fixed: Passing individual integer indices (0-8) instead of the whole 'board' list
    print(' ' + colored(board[0]) + ' | ' + colored(board[1]) + ' | ' + colored(board[2]))
    print(Fore.CYAN + '---+---+---' + Style.RESET_ALL)
    print(' ' + colored(board[3]) + ' | ' + colored(board[4]) + ' | ' + colored(board[5]))
    print(Fore.CYAN + '---+---+---' + Style.RESET_ALL)
    print(' ' + colored(board[6]) + ' | ' + colored(board[7]) + ' | ' + colored(board[8]))
    print()

def check_win(board, player):
    # Fixed: Sub-lists grouped correctly with numbers intact
    win_conditions = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8],  # Horizontal Rows
        [0, 3, 6], [1, 4, 7], [2, 5, 8],  # Vertical Columns
        [0, 4, 8], [2, 4, 6]              # Diagonals
    ]
    for condition in win_conditions:
        if board[condition[0]] == board[condition[1]] == board[condition[2]] == player:
            return True
    return False

def check_draw(board):
    return all(cell in ['X', 'O'] for cell in board)

def play_game():
    # Setup initial board with numbers 1 to 9
    board = [str(i) for i in range(1, 10)]
    
    print("Welcome to Tic-Tac-Toe!")
    print("You are " + Fore.RED + "X" + Style.RESET_ALL + ". The computer is " + Fore.BLUE + "O" + Style.RESET_ALL + ".")
    display_board(board)
    
    while True:
        # --- Player Turn ---
        while True:
            try:
                move = int(input("Enter your move (1-9): ")) - 1
                if 0 <= move <= 8 and board[move] not in ['X', 'O']:
                    board[move] = 'X'
                    break
                else:
                    print("Invalid move! Spot already taken or out of bounds.")
            except ValueError:
                print("Please enter a valid number between 1 and 9.")
        
        display_board(board)
        if check_win(board, 'X'):
            print(Fore.GREEN + "🎉 Congratulations! You won! 🎉")
            break
        if check_draw(board):
            print(Fore.YELLOW + "It's a draw! 🤝")
            break
            
        # --- Computer Turn ---
        print("Computer is thinking...")
        available_moves = [i for i in range(9) if board[i] not in ['X', 'O']]
        computer_move = random.choice(available_moves)
        board[computer_move] = 'O'
        
        display_board(board)
        if check_win(board, 'O'):
            print(Fore.RED + "Game Over! The computer won. 🤖")
            break
        if check_draw(board):
            print(Fore.YELLOW + "It's a draw! 🤝")
            break

if __name__ == "__main__":
    play_game()
